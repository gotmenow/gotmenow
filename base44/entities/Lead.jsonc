{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "service_interest": {
      "type": "string",
      "enum": [
        "Business Consulting",
        "Startup Consulting",
        "Passive Income Consulting",
        "Not sure yet"
      ]
    },
    "message": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "website"
    }
  },
  "required": [
    "name",
    "email",
    "phone",
    "service_interest"
  ]
}